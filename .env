# Base URL of the U44 backend API, with no trailing slash.
# Take it from the SAM stack output `ApiBaseURL` (backend/template.yaml).
#
# Required for the award pages. The award info is edited through the 관리 screen and served by the
# backend, so it has no static copy any more: with this empty, the schedule and 수상자 sections say
# they have no address to read from, and the 관리 route is not mounted at all.
# The remaining configs (homescreen, instaposts) are still plain files under public/configs and work
# without a backend, so the rest of the site keeps running.
#
# The asset (CloudFront) URL is deliberately NOT listed here: the API already returns full image
# URLs, so the frontend never has to build one.
VITE_API_BASE_URL=https://d1kdqje0mi6yok.cloudfront.net
